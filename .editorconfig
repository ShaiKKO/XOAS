root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_style = space
indent_size = 2

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[tests/quality/fixtures/generated/output/**]
insert_final_newline = unset
trim_trailing_whitespace = unset

[tests/quality/fixtures/vendor/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
