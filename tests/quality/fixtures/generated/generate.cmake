cmake_minimum_required(VERSION 3.28)

foreach(requiredVariable XOAS_GENERATED_INPUT XOAS_GENERATED_OUTPUT)
  if(NOT DEFINED ${requiredVariable})
    message(FATAL_ERROR "${requiredVariable} is required.")
  endif()
endforeach()

file(READ "${XOAS_GENERATED_INPUT}" generatedInputJson)
foreach(inputField
        canonical_problem_digest
        generator
        numerical_contract
        required_target_features)
  string(JSON "${inputField}" GET "${generatedInputJson}" "${inputField}")
endforeach()

if(NOT generator STREQUAL "xoas-quality-fixture-generator-v1")
  message(FATAL_ERROR "Unexpected quality-fixture generator identity.")
endif()
if(NOT canonical_problem_digest MATCHES "^[0-9a-f]+$" OR
   NOT numerical_contract MATCHES "^[a-z_]+$" OR
   NOT required_target_features MATCHES "^[A-Za-z0-9_.+-]+$")
  message(FATAL_ERROR "Generated fixture input contains an invalid field.")
endif()

set(generatedSource [=[
/// \file
/// Generated by @generator@.
///
/// DO NOT EDIT. Change the generator or canonical input and regenerate.
/// Canonical problem digest:
/// @canonical_problem_digest@.
/// Numerical contract: @numerical_contract@.
/// Required target features: @required_target_features@.

#include <string_view>

namespace xoas::quality::generated {

[[maybe_unused]] constexpr std::string_view GeneratorIdentity =
    "@generator@";
[[maybe_unused]] constexpr std::string_view CanonicalProblemDigest =
    "@canonical_problem_digest@";
[[maybe_unused]] constexpr std::string_view NumericalContract = "@numerical_contract@";
[[maybe_unused]] constexpr std::string_view RequiredTargetFeatures = "@required_target_features@";

} // namespace xoas::quality::generated
]=])
string(CONFIGURE "${generatedSource}" configuredSource @ONLY)
file(WRITE "${XOAS_GENERATED_OUTPUT}" "${configuredSource}")
