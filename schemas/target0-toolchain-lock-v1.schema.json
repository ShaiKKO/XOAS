{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xoas.dev/schemas/target0-toolchain-lock-v1.schema.json",
  "title": "XOAS Target 0 Toolchain Lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "lock_id",
    "captured_at_utc",
    "state",
    "execution_subject",
    "target",
    "repository",
    "install_prefix",
    "apt",
    "existing_executables",
    "source_locks",
    "baseline_dispositions",
    "installed_package_closure",
    "installed_files",
    "validations",
    "rollback",
    "compatibility_digest_status",
    "performance_claim",
    "baseline_stack_verified",
    "target0_measurement_qualified"
  ],
  "properties": {
    "manifest_version": {
      "const": "xoas.target0-toolchain-lock.v1"
    },
    "lock_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "captured_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "resolved_not_installed",
        "installed_unverified",
        "installed_verified"
      ]
    },
    "execution_subject": {
      "$ref": "#/$defs/gitCommit"
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "install_prefix": {
      "const": "/opt/xoas/target0-v1"
    },
    "apt": {
      "$ref": "#/$defs/apt"
    },
    "existing_executables": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/executable"
      }
    },
    "source_locks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceLock"
      }
    },
    "baseline_dispositions": {
      "$ref": "#/$defs/baselineDispositions"
    },
    "installed_package_closure": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/installedPackage"
      }
    },
    "installed_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/installedFile"
      }
    },
    "validations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/validation"
      }
    },
    "rollback": {
      "$ref": "#/$defs/rollback"
    },
    "configuration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "compatibility_digest_status": {
      "const": "canonical_binary_identity_deferred_to_M1"
    },
    "performance_claim": {
      "const": false
    },
    "baseline_stack_verified": {
      "type": "boolean"
    },
    "target0_measurement_qualified": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operating_system",
        "version_id",
        "codename",
        "architecture",
        "cpu",
        "topology"
      ],
      "properties": {
        "operating_system": {
          "const": "ubuntu"
        },
        "version_id": {
          "const": "26.04"
        },
        "codename": {
          "const": "resolute"
        },
        "architecture": {
          "const": "x86_64"
        },
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vendor_id",
            "family",
            "model",
            "stepping",
            "model_name"
          ],
          "properties": {
            "vendor_id": {
              "const": "AuthenticAMD"
            },
            "family": {
              "const": 25
            },
            "model": {
              "const": 97
            },
            "stepping": {
              "const": 2
            },
            "model_name": {
              "const": "AMD Ryzen 9 7900X 12-Core Processor"
            }
          }
        },
        "topology": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "logical_cpu_count",
            "physical_core_count",
            "numa_node_count"
          ],
          "properties": {
            "logical_cpu_count": {
              "const": 24
            },
            "physical_core_count": {
              "const": 12
            },
            "numa_node_count": {
              "const": 1
            }
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree_state",
        "public_remote"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "tree_state": {
          "const": "clean"
        },
        "public_remote": {
          "const": "https://github.com/ShaiKKO/XOAS.git"
        }
      }
    },
    "apt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "refreshed_at_utc",
        "refresh_log_sha256",
        "requested_packages",
        "simulation",
        "prestate"
      ],
      "properties": {
        "refreshed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "refresh_log_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "requested_packages": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requestedPackage"
          }
        },
        "simulation": {
          "$ref": "#/$defs/installSimulation"
        },
        "prestate": {
          "$ref": "#/$defs/packagePrestate"
        }
      }
    },
    "requestedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "installed_version",
        "candidate_version",
        "origins"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+.-]+$"
        },
        "installed_version": {
          "type": ["string", "null"]
        },
        "candidate_version": {
          "type": "string",
          "minLength": 1
        },
        "origins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/aptOrigin"
          }
        }
      }
    },
    "aptOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "uri",
        "suite",
        "component",
        "architecture"
      ],
      "properties": {
        "priority": {
          "type": "integer",
          "minimum": 1
        },
        "uri": {
          "type": "string",
          "pattern": "^https?://"
        },
        "suite": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "installSimulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "log_sha256",
        "summary",
        "requested_package_count",
        "new_package_count",
        "upgrade_count",
        "removal_count"
      ],
      "properties": {
        "result": {
          "const": "passed"
        },
        "log_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "requested_package_count": {
          "const": 9
        },
        "new_package_count": {
          "type": "integer",
          "minimum": 0
        },
        "upgrade_count": {
          "const": 0
        },
        "removal_count": {
          "const": 0
        }
      }
    },
    "packagePrestate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holds",
        "holds_sha256",
        "package_count",
        "packages_sha256",
        "packages"
      ],
      "properties": {
        "holds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "holds_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "package_count": {
          "type": "integer",
          "minimum": 1
        },
        "packages_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/prestatePackage"
          }
        }
      }
    },
    "prestatePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "available",
        "path",
        "version_line",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "available": {
          "type": "boolean"
        },
        "path": {
          "type": ["string", "null"]
        },
        "version_line": {
          "type": ["string", "null"]
        },
        "sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "available": {"const": true}
            },
            "required": ["available"]
          },
          "then": {
            "properties": {
              "path": {"type": "string", "pattern": "^/"},
              "version_line": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "else": {
            "properties": {
              "path": {"type": "null"},
              "version_line": {"type": "null"},
              "sha256": {"type": "null"}
            }
          }
        }
      ]
    },
    "sourceLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository_url",
        "tag",
        "commit",
        "source_archive_sha256",
        "license",
        "state",
        "install_prefix",
        "configure_commands",
        "build_commands",
        "test_commands",
        "install_commands"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]+$"
        },
        "repository_url": {
          "type": "string",
          "pattern": "^https://github\\.com/"
        },
        "tag": {
          "type": ["string", "null"]
        },
        "commit": {
          "$ref": "#/$defs/gitCommit"
        },
        "source_archive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "state": {
          "enum": [
            "identity_only",
            "resolved_not_installed",
            "source_identity_pinned_adapter_deferred_M2"
          ]
        },
        "install_prefix": {
          "type": ["string", "null"]
        },
        "configure_commands": {
          "$ref": "#/$defs/commands"
        },
        "build_commands": {
          "$ref": "#/$defs/commands"
        },
        "test_commands": {
          "$ref": "#/$defs/commands"
        },
        "install_commands": {
          "$ref": "#/$defs/commands"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "path",
        "sha256",
        "use_authorized"
      ],
      "properties": {
        "status": {
          "enum": ["present", "missing_at_pinned_revision"]
        },
        "path": {
          "type": ["string", "null"]
        },
        "sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "use_authorized": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"const": "present"}
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "else": {
            "properties": {
              "path": {"type": "null"},
              "sha256": {"type": "null"},
              "use_authorized": {"const": false}
            }
          }
        }
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "baselineDispositions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one_mkl", "jitspmm"],
      "properties": {
        "one_mkl": {
          "const": "not_installed_pending_M2_applicability_review"
        },
        "jitspmm": {
          "const": "source_identity_pinned_adapter_deferred_M2"
        }
      }
    },
    "installedPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "architecture",
        "origins",
        "package_file_status"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "origins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "package_file_status": {
          "enum": ["passed", "failed"]
        }
      }
    },
    "installedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/opt/xoas/target0-v1/"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "command", "evidence"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]+$"
        },
        "status": {
          "enum": ["pending", "passed", "failed"]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefix_collision_absent",
        "quarantine_path_template",
        "package_removal_policy"
      ],
      "properties": {
        "prefix_collision_absent": {
          "type": "boolean"
        },
        "quarantine_path_template": {
          "const": "/opt/xoas/target0-v1.quarantine-YYYYmmddTHHMMSSZ"
        },
        "package_removal_policy": {
          "const": "no_removal_without_separate_administrator_review"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {"const": "resolved_not_installed"}
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "installed_package_closure": {"maxItems": 0},
          "installed_files": {"maxItems": 0},
          "baseline_stack_verified": {"const": false}
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {"const": "installed_verified"}
        },
        "required": ["state"]
      },
      "then": {
        "required": ["configuration_sha256"],
        "properties": {
          "installed_package_closure": {"minItems": 1},
          "installed_files": {"minItems": 1},
          "baseline_stack_verified": {"const": true}
        }
      }
    }
  ]
}
