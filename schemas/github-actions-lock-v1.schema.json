{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xoas.dev/schemas/github-actions-lock-v1.schema.json",
  "title": "XOAS GitHub Actions lock v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "captured_at_utc",
    "workflow_path",
    "runner_label",
    "permissions",
    "toolchain_lock_id",
    "apt_archive",
    "apt_packages",
    "actions",
    "required_contexts"
  ],
  "properties": {
    "manifest_version": {
      "const": "xoas.github-actions-lock.v1"
    },
    "captured_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "workflow_path": {
      "const": ".github/workflows/quality.yml"
    },
    "runner_label": {
      "const": "ubuntu-24.04"
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contents"],
      "properties": {
        "contents": {
          "const": "read"
        }
      }
    },
    "toolchain_lock_id": {
      "type": "string",
      "minLength": 1
    },
    "apt_archive": {
      "$ref": "#/$defs/aptArchive"
    },
    "apt_packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/aptPackage"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "required_contexts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "quality / repository-policy",
          "quality / static-quality",
          "quality / debug-build-and-test",
          "quality / release-build-and-test",
          "quality / sanitizers"
        ]
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "aptArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "suite",
        "component",
        "source_line",
        "key_url",
        "key_fingerprint",
        "keyring_sha256",
        "source_file_sha256"
      ],
      "properties": {
        "source_url": {
          "const": "https://apt.llvm.org/noble/"
        },
        "suite": {
          "const": "llvm-toolchain-noble-21"
        },
        "component": {
          "const": "main"
        },
        "source_line": {
          "type": "string",
          "minLength": 1
        },
        "key_url": {
          "type": "string",
          "format": "uri"
        },
        "key_fingerprint": {
          "type": "string",
          "pattern": "^[0-9A-F]{40}$"
        },
        "keyring_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_file_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "aptPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+.-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "release_tag",
        "release_immutable",
        "commit_sha",
        "purpose",
        "resolved_via",
        "verification"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "release_tag": {
          "type": "string",
          "minLength": 1
        },
        "release_immutable": {
          "type": "boolean"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "purpose": {
          "type": "string",
          "minLength": 16
        },
        "resolved_via": {
          "type": "string",
          "format": "uri"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "reason", "verified_at_utc"],
      "properties": {
        "verified": {
          "const": true
        },
        "reason": {
          "const": "valid"
        },
        "verified_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
