{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xoas.dev/schemas/quality-gates-v1.schema.json",
  "title": "XOAS quality gate contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "toolchain_lock_id",
    "required_ci_contexts",
    "source_classifications",
    "gates"
  ],
  "properties": {
    "contract_version": {
      "const": "xoas.quality-gates.v1"
    },
    "toolchain_lock_id": {
      "type": "string",
      "minLength": 1
    },
    "required_ci_contexts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "quality / repository-policy",
          "quality / static-quality",
          "quality / debug-build-and-test",
          "quality / release-build-and-test",
          "quality / sanitizers"
        ]
      }
    },
    "source_classifications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handwritten_roots", "generated_roots", "vendored_roots"],
      "properties": {
        "handwritten_roots": {
          "$ref": "#/$defs/nonemptyUniquePaths"
        },
        "generated_roots": {
          "$ref": "#/$defs/nonemptyUniquePaths"
        },
        "vendored_roots": {
          "$ref": "#/$defs/nonemptyUniquePaths"
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/gate"
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "nonemptyUniquePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "changeClass": {
      "enum": [
        "documentation",
        "configuration",
        "handwritten_cpp",
        "semantic_ir",
        "code_generation",
        "runtime_cache",
        "performance_claim"
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state",
        "change_classes",
        "positive_fixtures",
        "negative_fixtures",
        "ci_required",
        "evidence_commands"
      ],
      "properties": {
        "name": {
          "enum": [
            "format-check",
            "warnings",
            "tidy",
            "docs-check",
            "test",
            "asan-ubsan",
            "repository-policy",
            "quality"
          ]
        },
        "state": {
          "enum": ["red", "green"]
        },
        "change_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/changeClass"
          }
        },
        "positive_fixtures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "negative_fixtures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "ci_required": {
          "type": "boolean"
        },
        "evidence_commands": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rule_identities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^xoas-[a-z0-9-]+$"
          }
        },
        "exclusions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exclusion"
          }
        },
        "aggregate_evidence": {
          "$ref": "#/$defs/aggregateEvidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "repository-policy"
              }
            },
            "required": ["name"]
          },
          "then": {
            "required": ["rule_identities", "exclusions"]
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "quality"
              },
              "state": {
                "const": "green"
              }
            },
            "required": ["name", "state"]
          },
          "then": {
            "required": ["aggregate_evidence"]
          }
        }
      ]
    },
    "aggregateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clean_candidate_wall_clock_seconds",
        "toolchain_lock_id",
        "cleanup_paths"
      ],
      "properties": {
        "clean_candidate_wall_clock_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "toolchain_lock_id": {
          "type": "string",
          "minLength": 1
        },
        "cleanup_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "rule", "rationale"],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "rule": {
          "type": "string",
          "pattern": "^xoas-[a-z0-9-]+$"
        },
        "rationale": {
          "type": "string",
          "minLength": 16
        }
      }
    }
  }
}
