{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xoas.dev/schemas/target0-qualification-campaign-v1.schema.json",
  "title": "XOAS Target 0 qualification campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "performance_claim",
    "qualification_claim",
    "campaign_id",
    "campaign_number",
    "target_id",
    "status",
    "created_at_utc",
    "completed_at_utc",
    "controlled_reboot_preceded_campaign",
    "repository",
    "bundle",
    "provisioning_lock",
    "preflight",
    "selected_core",
    "processes",
    "pmu",
    "acceptance",
    "evidence_inventory_sha256",
    "external_retention"
  ],
  "properties": {
    "manifest_version": {
      "const": "xoas.target0-qualification-campaign.v1"
    },
    "performance_claim": {
      "const": false
    },
    "qualification_claim": {
      "const": false
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "campaign_number": {
      "enum": [1, 2]
    },
    "target_id": {
      "const": "target0-amd-ryzen9-7900x-v1"
    },
    "status": {
      "const": "passed"
    },
    "created_at_utc": {
      "$ref": "#/$defs/timestamp"
    },
    "completed_at_utc": {
      "$ref": "#/$defs/timestamp"
    },
    "controlled_reboot_preceded_campaign": {
      "type": "boolean"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_commit", "actual_commit", "tree", "tree_state"],
      "properties": {
        "expected_commit": { "$ref": "#/$defs/git_object" },
        "actual_commit": { "$ref": "#/$defs/git_object" },
        "tree": { "$ref": "#/$defs/git_object" },
        "tree_state": { "const": "clean" }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "bundle_manifest_sha256",
        "bundle_inventory_sha256",
        "executable_sha256",
        "executable_identity_sha256"
      ],
      "properties": {
        "bundle_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "bundle_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "bundle_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "executable_identity_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "provisioning_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lock_id", "file_sha256", "configuration_sha256"],
      "properties": {
        "lock_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,128}$"
        },
        "file_sha256": { "$ref": "#/$defs/sha256" },
        "configuration_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exclusive_use_confirmed",
        "load_average_1m",
        "interactive_sessions",
        "thermal",
        "clocksource",
        "bare_metal",
        "required_pmu_available"
      ],
      "properties": {
        "exclusive_use_confirmed": { "const": true },
        "load_average_1m": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 0.5
        },
        "interactive_sessions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "expected", "root", "unexpected"],
          "properties": {
            "total": { "$ref": "#/$defs/nonnegative_integer" },
            "expected": { "$ref": "#/$defs/nonnegative_integer" },
            "root": { "const": 0 },
            "unexpected": { "const": 0 }
          }
        },
        "thermal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sensor_count",
            "alarm_count",
            "fault_count",
            "threshold_violation_count",
            "threshold_unavailable_count"
          ],
          "properties": {
            "sensor_count": { "type": "integer", "minimum": 1 },
            "alarm_count": { "const": 0 },
            "fault_count": { "const": 0 },
            "threshold_violation_count": { "const": 0 },
            "threshold_unavailable_count": {
              "$ref": "#/$defs/nonnegative_integer"
            }
          }
        },
        "clocksource": { "const": "tsc" },
        "bare_metal": { "const": true },
        "required_pmu_available": { "const": true }
      }
    },
    "selected_core": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "sibling",
        "preferred_core_ranking",
        "interrupt_delta",
        "window_seconds"
      ],
      "properties": {
        "cpu": { "$ref": "#/$defs/cpu" },
        "sibling": { "$ref": "#/$defs/cpu" },
        "preferred_core_ranking": { "$ref": "#/$defs/nonnegative_integer" },
        "interrupt_delta": { "$ref": "#/$defs/nonnegative_integer" },
        "window_seconds": { "const": 60 }
      }
    },
    "processes": {
      "type": "array",
      "items": { "$ref": "#/$defs/process_summary" },
      "minItems": 5,
      "maxItems": 5
    },
    "pmu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "optional"],
      "properties": {
        "required": { "$ref": "#/$defs/required_pmu" },
        "optional": {
          "type": "array",
          "items": { "$ref": "#/$defs/optional_pmu" },
          "minItems": 8,
          "maxItems": 8
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "process_count",
        "retained_sample_count",
        "strict_mad_process_count",
        "all_mad_at_most_0_010",
        "all_p99_at_most_1_02",
        "all_restored",
        "required_pmu_accepted"
      ],
      "properties": {
        "status": { "const": "passed" },
        "process_count": { "const": 5 },
        "retained_sample_count": { "const": 150 },
        "strict_mad_process_count": { "type": "integer", "minimum": 4, "maximum": 5 },
        "all_mad_at_most_0_010": { "const": true },
        "all_p99_at_most_1_02": { "const": true },
        "all_restored": { "const": true },
        "required_pmu_accepted": { "const": true }
      }
    },
    "evidence_inventory_sha256": { "$ref": "#/$defs/sha256" },
    "external_retention": { "const": "external_private_evidence_root" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_object": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "cpu": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048575
    },
    "ratio": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{12}$"
    },
    "fraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "$ref": "#/$defs/nonnegative_integer" },
        "denominator": { "type": "integer", "minimum": 1 }
      }
    },
    "statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "minimum_ns",
        "maximum_ns",
        "median_ns",
        "mad_ns",
        "mad_ratio",
        "p99_ns",
        "p99_ratio"
      ],
      "properties": {
        "sample_count": { "const": 30 },
        "minimum_ns": { "type": "integer", "minimum": 20000000, "maximum": 200000000 },
        "maximum_ns": { "type": "integer", "minimum": 20000000, "maximum": 200000000 },
        "median_ns": { "$ref": "#/$defs/fraction" },
        "mad_ns": { "$ref": "#/$defs/fraction" },
        "mad_ratio": { "$ref": "#/$defs/ratio" },
        "p99_ns": { "type": "integer", "minimum": 20000000, "maximum": 200000000 },
        "p99_ratio": { "$ref": "#/$defs/ratio" }
      }
    },
    "process_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_sha256",
        "host_before_sha256",
        "process_sha256",
        "restoration_sha256",
        "host_after_sha256"
      ],
      "properties": {
        "identity_sha256": { "$ref": "#/$defs/sha256" },
        "host_before_sha256": { "$ref": "#/$defs/sha256" },
        "process_sha256": { "$ref": "#/$defs/sha256" },
        "restoration_sha256": { "$ref": "#/$defs/sha256" },
        "host_after_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "process_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_index",
        "seed",
        "accepted",
        "restored",
        "statistics",
        "evidence"
      ],
      "properties": {
        "process_index": { "type": "integer", "minimum": 1, "maximum": 5 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 },
        "accepted": { "const": true },
        "restored": { "const": true },
        "statistics": { "$ref": "#/$defs/statistics" },
        "evidence": { "$ref": "#/$defs/process_evidence" }
      }
    },
    "perf_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "status", "value", "running_percentage"],
      "properties": {
        "event": {
          "enum": [
            "cycles",
            "instructions",
            "branches",
            "branch-misses",
            "cache-references",
            "cache-misses",
            "msr/aperf/",
            "msr/mperf/",
            "msr/tsc/",
            "power/energy-pkg/"
          ]
        },
        "status": { "enum": ["supported", "unsupported"] },
        "value": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
            { "type": "null" }
          ]
        },
        "running_percentage": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)?$" },
            { "type": "null" }
          ]
        }
      }
    },
    "required_pmu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "restored", "events", "evidence_sha256"],
      "properties": {
        "status": { "const": "passed" },
        "restored": { "const": true },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/perf_event" },
          "minItems": 2,
          "maxItems": 2
        },
        "evidence_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "optional_pmu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "status", "restored", "record", "evidence_sha256"],
      "properties": {
        "event": {
          "enum": [
            "branches",
            "branch-misses",
            "cache-references",
            "cache-misses",
            "msr/aperf/",
            "msr/mperf/",
            "msr/tsc/",
            "power/energy-pkg/"
          ]
        },
        "status": { "enum": ["supported", "unsupported"] },
        "restored": { "const": true },
        "record": { "$ref": "#/$defs/perf_event" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
