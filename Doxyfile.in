DOXYFILE_ENCODING       = UTF-8
PROJECT_NAME            = XOAS
PROJECT_BRIEF           = "Exact-instance matrix-kernel synthesizer"
OUTPUT_DIRECTORY        = @XOAS_DOXYGEN_OUTPUT_DIRECTORY@
CREATE_SUBDIRS          = NO
OUTPUT_LANGUAGE         = English
BRIEF_MEMBER_DESC       = YES
REPEAT_BRIEF            = NO
ALWAYS_DETAILED_SEC     = NO
JAVADOC_AUTOBRIEF       = NO
QT_AUTOBRIEF            = NO
INHERIT_DOCS            = NO
FULL_PATH_NAMES         = YES
STRIP_FROM_PATH         = @XOAS_DOXYGEN_STRIP_PATH@
OPTIMIZE_OUTPUT_FOR_C   = NO
MARKDOWN_SUPPORT        = YES
AUTOLINK_SUPPORT        = YES
BUILTIN_STL_SUPPORT     = YES
CPP_CLI_SUPPORT         = NO
SIP_SUPPORT             = NO
EXTRACT_ALL             = NO
EXTRACT_PRIVATE         = NO
EXTRACT_PRIV_VIRTUAL    = NO
EXTRACT_PACKAGE         = NO
EXTRACT_STATIC          = YES
EXTRACT_LOCAL_CLASSES   = YES
EXTRACT_LOCAL_METHODS   = NO
HIDE_UNDOC_MEMBERS      = NO
HIDE_UNDOC_CLASSES      = NO
HIDE_FRIEND_COMPOUNDS   = NO
HIDE_IN_BODY_DOCS       = NO
INTERNAL_DOCS           = NO
CASE_SENSE_NAMES        = YES
HIDE_SCOPE_NAMES        = NO
HIDE_COMPOUND_REFERENCE = NO
SHOW_HEADERFILE         = YES
SHOW_INCLUDE_FILES      = YES
SHOW_GROUPED_MEMB_INC   = NO
FORCE_LOCAL_INCLUDES    = NO
INLINE_INFO             = YES
SORT_MEMBER_DOCS        = YES
SORT_BRIEF_DOCS         = NO
SORT_MEMBERS_CTORS_1ST  = YES
SORT_GROUP_NAMES        = NO
SORT_BY_SCOPE_NAME      = YES
STRICT_PROTO_MATCHING   = YES
GENERATE_TODOLIST       = NO
GENERATE_TESTLIST       = NO
GENERATE_BUGLIST        = NO
GENERATE_DEPRECATEDLIST = YES
MAX_INITIALIZER_LINES   = 30
SHOW_USED_FILES         = YES
SHOW_FILES              = YES
SHOW_NAMESPACES         = YES
QUIET                   = YES
WARNINGS                = YES
WARN_IF_UNDOCUMENTED    = YES
WARN_IF_DOC_ERROR       = YES
WARN_IF_INCOMPLETE_DOC  = YES
WARN_NO_PARAMDOC        = YES
WARN_AS_ERROR           = FAIL_ON_WARNINGS
WARN_FORMAT             = "$file:$line: $text"
WARN_LOGFILE            = @XOAS_DOXYGEN_WARN_LOG@
INPUT                   = @XOAS_DOXYGEN_INPUTS@
INPUT_ENCODING          = UTF-8
FILE_PATTERNS           = *.c *.cc *.cpp *.cxx *.h *.hh *.hpp *.hxx
RECURSIVE               = NO
EXCLUDE_SYMLINKS        = YES
EXAMPLE_RECURSIVE       = NO
SOURCE_BROWSER          = YES
INLINE_SOURCES          = NO
STRIP_CODE_COMMENTS     = YES
REFERENCED_BY_RELATION  = YES
REFERENCES_RELATION     = YES
REFERENCES_LINK_SOURCE  = YES
USE_HTAGS               = NO
VERBATIM_HEADERS        = YES
CLANG_ASSISTED_PARSING  = NO
ALPHABETICAL_INDEX      = NO
GENERATE_HTML           = YES
HTML_OUTPUT             = html
GENERATE_TREEVIEW       = NO
DISABLE_INDEX           = NO
GENERATE_LATEX          = NO
GENERATE_XML            = NO
HAVE_DOT                = YES
DOT_NUM_THREADS         = 1
CLASS_GRAPH             = YES
COLLABORATION_GRAPH     = YES
GROUP_GRAPHS            = YES
UML_LOOK                = NO
CALL_GRAPH              = NO
CALLER_GRAPH            = NO
DIRECTORY_GRAPH         = YES
DOT_IMAGE_FORMAT        = svg
INTERACTIVE_SVG         = NO
