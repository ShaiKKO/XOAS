{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "clang-21-base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_AR": "/usr/bin/llvm-ar-21",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-21",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "dev-debug",
      "displayName": "XOAS development debug",
      "inherits": "clang-21-base",
      "binaryDir": "${sourceDir}/build/dev-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=/usr/bin/ld.lld-21",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=/usr/bin/ld.lld-21",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=/usr/bin/ld.lld-21"
      }
    },
    {
      "name": "dev-release",
      "displayName": "XOAS development release",
      "inherits": "clang-21-base",
      "binaryDir": "${sourceDir}/build/dev-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=/usr/bin/ld.lld-21",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=/usr/bin/ld.lld-21",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=/usr/bin/ld.lld-21"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "XOAS ASan and UBSan",
      "inherits": "clang-21-base",
      "binaryDir": "${sourceDir}/build/asan-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXE_LINKER_FLAGS": "-fuse-ld=/usr/bin/ld.lld-21",
        "CMAKE_MODULE_LINKER_FLAGS": "-fuse-ld=/usr/bin/ld.lld-21",
        "CMAKE_SHARED_LINKER_FLAGS": "-fuse-ld=/usr/bin/ld.lld-21",
        "XOAS_ENABLE_SANITIZERS": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug"
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    }
  ],
  "testPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "environment": {
        "ASAN_OPTIONS": "abort_on_error=1:halt_on_error=1:detect_leaks=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
